/// <p>Install-seeded query-knowledge corpus (Story 14.1 / FR62) — the
/// distilled content of <code>docs/iris-query-guide/</code> (10 files)
/// carried as XData JSON blocks and upserted into
/// <CLASS>SessionAgent.Knowledge.Article</CLASS> rows by the idempotent
/// <method>Seed</method> method.</p>
///
/// <p><b>XData layout (one block per topic group).</b> Each XData block
/// below carries a JSON array of article objects of the shape
/// <code>{slug, topic, title, keywords, body}</code>:</p>
/// <ul>
/// <li><code>Methodology</code> — 2 articles (the build loop + the
/// diagnostic checklist with SQLCODE hint lines).</li>
/// <li><code>Dialect</code> — 14 articles (TOP-not-LIMIT, %ID joins,
/// class-to-table, dates, decode functions, integer-string trap, case +
/// %EXACT, $LIST, streams, GROUP BY restrictions, reserved aliases,
/// COUNT(DISTINCT) cost, prefix match, hint placement).</li>
/// <li><code>MessageModel</code> — 8 articles (persistence projection,
/// inheritance/extents/%CLASSNAME, header spine, header-body join,
/// sessions, request/response correlation, errors-on-response,
/// AdditionalInfo pivot).</li>
/// <li><code>Performance</code> — 6 articles (cost-vs-runtime, %PARALLEL,
/// %IGNOREINDEX, indexing realities, I/O-bound vs plan-bound, orphan
/// caveats).</li>
/// <li><code>Discovery</code> — 2 articles (custom-table workflow,
/// search-table tip).</li>
/// <li><code>Reference</code> — 3 articles (Ens.MessageHeader card,
/// Ens.Util.Log card, HS.* body patterns — patterns only, names flagged
/// verify-live).</li>
/// <li><code>Cookbook</code> — 12 parameterizable recipes with
/// placeholder markers (<code>{component}</code>,
/// <code>:session_id</code>, <code>{Body.Class.Name}</code>).</li>
/// </ul>
///
/// <p><b>Contract notes.</b> Bodies are ASCII-only (Rule 12 mojibake
/// precedent; enforced by <CLASS>SessionAgent.Test.KnowledgeCorpusTest</CLASS>).
/// The <code>diagnostic-checklist</code> article carries
/// <code>SQLCODE &lt;n&gt; / symptom -&gt; fix</code> lines (including
/// -29, -37, -400) — Story 14.3's error-envelope hint map consumes that
/// shape; it is a locked contract.</p>
///
/// <p><b>Idempotent <method>Seed</method> (NFR-R5).</b> Upserts by
/// <code>Slug</code> via the generated unique-index accessors — re-running
/// never duplicates rows; updated bodies overwrite. Invoked by
/// <CLASS>SessionAgent.Installer</CLASS> after
/// <code>SeedVocabulary.Seed()</code>; the Installer logs the post-seed
/// article count to the install log.</p>
///
/// <p><b>References:</b></p>
/// <ul>
/// <li><a href="../../../docs/iris-query-guide/README.md">docs/iris-query-guide/</a> — distillation source.</li>
/// <li><a href="../Search/SeedVocabulary.cls">SessionAgent.Search.SeedVocabulary</a> — idempotent-seed precedent.</li>
/// <li><a href="../../../_bmad-output/implementation-artifacts/14-1-knowledge-corpus-get-query-knowledge-tool.md">Story 14.1</a> — AC-2/AC-3 source.</li>
/// </ul>
Class SessionAgent.Knowledge.SeedContent Extends %RegisteredObject
{

/// <p>Ordered list of the XData block names <method>Seed</method> parses.
/// Kept in one place so tests and the seed loop cannot drift.</p>
ClassMethod GetXDataNames() As %List
{
    Quit $ListBuild("Methodology", "Dialect", "MessageModel", "Performance", "Discovery", "Reference", "Cookbook")
}

/// <p>Idempotently upsert every article carried in the XData blocks into
/// <CLASS>SessionAgent.Knowledge.Article</CLASS>. Upsert key is
/// <code>Slug</code> (unique index): an existing row is updated in place
/// (topic/title/keywords/body overwrite), a missing row is inserted.
/// Re-running is safe and never duplicates (NFR-R5).</p>
///
/// <p><b>Returns</b> <code>$$$OK</code> on full success, otherwise the
/// failing <code>%Status</code>. The Installer propagates the status per
/// project rule "Write Status Checking".</p>
ClassMethod Seed() As %Status
{
    Set tSC = $$$OK
    Try {
        Set tNames = ..GetXDataNames()
        Set tPtr = 0
        While $ListNext(tNames, tPtr, tName) {
            Set tXData = ##class(%Dictionary.XDataDefinition).IDKEYOpen("SessionAgent.Knowledge.SeedContent", tName, , .tOpenSC)
            If '$IsObject(tXData) {
                Set tSC = $$$ERROR($$$GeneralError, "SeedContent XData block missing: " _ tName _ " (" _ $System.Status.GetErrorText($Get(tOpenSC, $$$OK)) _ ")")
                Quit
            }
            Set tArr = ##class(%DynamicArray).%FromJSON(tXData.Data)
            Set tIter = tArr.%GetIterator()
            While tIter.%GetNext(.tKey, .tArt) {
                Set tSC = ..UpsertArticle(tArt.%Get("slug"), tArt.%Get("topic"), tArt.%Get("title"), tArt.%Get("keywords"), tArt.%Get("body"))
                If $$$ISERR(tSC) Quit
            }
            If $$$ISERR(tSC) Quit
        }
    }
    Catch ex {
        Set tSC = ex.AsStatus()
    }
    Quit tSC
}

/// <p>Upsert one article by <var>pSlug</var>. Uses the generated
/// unique-index accessors (<code>SlugIdxExists</code> /
/// <code>SlugIdxOpen</code>) for the existence probe — no SQL needed,
/// and the unique index guarantees at most one match.</p>
ClassMethod UpsertArticle(pSlug As %String, pTopic As %String, pTitle As %String, pKeywords As %String, pBody As %String) As %Status [ Private ]
{
    Set tSC = $$$OK
    Try {
        If pSlug = "" {
            Set tSC = $$$ERROR($$$GeneralError, "SeedContent article with empty slug (title: " _ pTitle _ ")")
            Quit
        }
        If ##class(SessionAgent.Knowledge.Article).SlugIdxExists(pSlug) {
            Set tRow = ##class(SessionAgent.Knowledge.Article).SlugIdxOpen(pSlug, , .tOpenSC)
            If '$IsObject(tRow) {
                Set tSC = $Get(tOpenSC, $$$ERROR($$$GeneralError, "SlugIdxOpen failed for " _ pSlug))
                Quit
            }
        } Else {
            Set tRow = ##class(SessionAgent.Knowledge.Article).%New()
            Set tRow.Slug = pSlug
        }
        Set tRow.Topic = pTopic
        Set tRow.Title = pTitle
        Set tRow.Keywords = pKeywords
        Set tRow.Body = pBody
        Set tSaveSC = tRow.%Save()
        If $$$ISERR(tSaveSC) {
            Set tSC = tSaveSC
            Quit
        }
    }
    Catch ex {
        Set tSC = ex.AsStatus()
    }
    Quit tSC
}

/// <p>Topic: methodology (2 articles). JSON array of
/// <code>{slug, topic, title, keywords, body}</code>.</p>
XData Methodology [ MimeType = application/json ]
{
[
{"slug":"methodology-loop","topic":"methodology","title":"The query-building loop: Discover -> Build -> Execute -> Validate -> Refine","keywords":"methodology,workflow,loop,discover,build,validate,refine,incremental,preview,approach,how to start","body":"The disciplined loop for building a correct trace query: Discover -> Build -> Execute -> Validate -> Refine.\n1. Understand the question before touching SQL: which table is the spine (almost always Ens.MessageHeader)? Header-only, or does payload content require a body-table JOIN? Per-message, per-session, or an aggregate/rate? What time window? Always bound by time; default to a narrow window (1 day) and widen on request.\n2. Discover only what you do not already know. Never assume a body table's columns - map MessageBodyClassName to schema.table, pull columns from INFORMATION_SCHEMA.COLUMNS, enumerate _AdditionalInfo keys. Persist what you learn (column types, decode functions, working JOIN patterns, gotchas) and re-read your notes before building a new query.\n3. Build incrementally: start FROM Ens.MessageHeader + a time filter + a handful of header columns; run it; add the body JOIN (with its MessageBodyClassName filter); run; add related-table JOINs, AdditionalInfo pivots, aggregates - each followed by a run. One change per iteration localizes every bug; debugging a 6-JOIN query that returns nothing is the slow path.\n4. Always run with a small SELECT TOP 10 first; only remove/raise the limit once the query is confirmed correct.\n5. Show the SQL and the output every single time - including diagnostic probes and schema lookups. Never run a query silently.\n6. Validate, then refine - never auto-confirm. After showing results, explicitly confirm the output is correct; diagnose problems against the diagnostic-checklist article, explain the fix and why, re-run, and confirm again before moving on."},
{"slug":"diagnostic-checklist","topic":"methodology","title":"Diagnostic checklist: symptom -> fix, including SQLCODE hints","keywords":"diagnostic,checklist,sqlcode,error,wrong results,missing rows,zero rows,duplicate rows,null,garbled,timeout,slow,debug","body":"When results are wrong or an error appears, walk this checklist.\nMissing rows / fewer than expected -> INNER JOIN excluding non-matching rows (switch to LEFT JOIN); or WHERE too tight (date range, exact class name); or MessageBodyClassName case/spelling wrong (verify the actual stored value).\nZero rows from a filter that should match -> integer column compared to a string literal (Type='Response', Status!='Delivered') silently coerces the string to 0; use the integer code or %EXTERNAL(). Also check for a hardcoded ID > N floor copied from another instance - ID magnitudes are per-instance.\nDuplicate rows -> cartesian product from a missing JOIN predicate, or genuinely multiple headers/bodies per session; fix the ON clause or discriminate by TargetConfigName - do not paper over a real join bug with DISTINCT.\nA column is all NULL -> a LEFT JOIN with no match (often correct - explain it), or you are reading the field on the wrong leg (SAML data is empty on responding/fan-out legs), or the column is genuinely unpopulated in this flow.\nGarbled / binary-looking data -> the column is an encoded %Status (%ODBCOUT), an integer-coded enum (%EXTERNAL), a $LIST ($LISTGET), or a stream (SUBSTRING).\nError text is many near-identical strings -> group by a truncated prefix and show MIN() of the full text.\nSQLCODE -1 / invalid alias -> the alias is a reserved word (COUNT, ROWS); rename it (Total, Cnt, MsgCount).\nSQLCODE -25 / input encountered after end of query -> a %PARALLEL or %IGNOREINDEX hint placed after the table name (hints go BEFORE the table), or %NOLOCK used where the endpoint rejects it (drop it).\nSQLCODE -29 / field not found -> you referenced a SELECT column alias in GROUP BY or ORDER BY; repeat the full expression, or compute it in a subquery and group/order by the alias outside.\nSQLCODE -37 / SQL function not supported -> SUBSTR used on a stream column; only SUBSTRING works on streams.\nSQLCODE -40 / fn escape not supported -> the ODBC escape (fn LOCATE) is not supported; use CHARINDEX instead.\nSQLCODE -400 / fatal error occurred -> internal failure, often from a malformed statement or an unsupported construct on this endpoint; simplify the statement, re-check syntax piece by piece, and retry; check messages.log if it persists.\nTimeout / very slow -> narrow the time window; lower TOP N; add %PARALLEL for large aggregates/anti-joins; add a matching time predicate ON a correlation JOIN (not just WHERE); avoid COUNT(DISTINCT) on huge tables."}
]
}

/// <p>Topic: dialect (14 articles). JSON array of
/// <code>{slug, topic, title, keywords, body}</code>.</p>
XData Dialect [ MimeType = application/json ]
{
[
{"slug":"top-not-limit","topic":"dialect","title":"Row limiting: SELECT TOP N, not LIMIT","keywords":"top,limit,row limiting,select top,max rows,preview,row cap,distinct","body":"IRIS does not support LIMIT. Use SELECT TOP N. TOP goes right after SELECT, and after DISTINCT if present: SELECT TOP 50 DISTINCT ...\nMost execution endpoints also accept an out-of-band max-rows cap (e.g. the Atelier API ?max=N) - keep a hard cap on every call as a safety net, independent of TOP.\nAlways preview new queries with a small TOP N (e.g. TOP 10) before raising or removing the limit; trace tables are huge."},
{"slug":"id-joins","topic":"dialect","title":"%ID pseudo-column: always use it in JOINs","keywords":"%id,id,rowid,join,pseudo-column,idkey,id1,identity,renamed","body":"%ID is a pseudo-column that always resolves to the row's RowID, even when the default ID column was renamed (IRIS renames it to ID1, ID2, ... when the class defines its own ID property) or the class uses an IDKEY on a string property.\nExample: INNER JOIN MyApp_Some.Body body ON hdr.MessageBodyId = body.%ID\nDo not confuse %ID with %ROWID - %ROWID is cursor-based and serves a different purpose; use %ID for joins and identity.\nWhen ID is a plain bigint that was not renamed, ID and %ID are interchangeable - but defaulting to %ID is always safe, so prefer it."},
{"slug":"class-to-table","topic":"dialect","title":"ObjectScript class name -> SQL schema.table","keywords":"class name,schema,table,mapping,package,dots,underscore,sqlschemaname,sqltablename,messagebodyclassname,convert","body":"Body tables are identified by class name in Ens.MessageHeader.MessageBodyClassName. To convert a class name to SQL schema.table: replace every dot EXCEPT the last with an underscore; everything before the last dot is the schema, the part after it is the table.\nExamples: EnsLib.HL7.Message -> EnsLib_HL7.Message; HS.Message.PatientSearchRequest -> HS_Message.PatientSearchRequest; My.App.Messages.PatientRequest -> My_App_Messages.PatientRequest; Ens.Util.Log -> Ens_Util.Log.\nThe default package User maps to schema SQLUser. A class can override either part with the SqlSchemaName / SqlTableName class keywords, so confirm from the catalog when unsure:\nSELECT Name, SqlSchemaName, SqlTableName FROM %Dictionary.CompiledClass WHERE ClassType = 'persistent' AND UPPER(Name) = UPPER('HS.Message.XMLMessage')"},
{"slug":"date-time-functions","topic":"dialect","title":"Dates and elapsed time: DATEADD, DATEDIFF, TIMESTAMPDIFF, TO_CHAR","keywords":"date,time,dateadd,datediff,timestampdiff,to_char,elapsed,window,daily,bucket,cast date,timestamp","body":"Date math: DATEADD('day', -N, CURRENT_TIMESTAMP) (also 'hour', 'minute', 'second', 'ms') - the workhorse for time-window filters.\nElapsed seconds: {fn TIMESTAMPDIFF(SQL_TSI_SECOND, ts1, ts2)} (ODBC scalar escape; also SQL_TSI_MINUTE, SQL_TSI_HOUR).\nElapsed milliseconds: DATEDIFF('ms', ts1, ts2).\nDate portion for display / daily grouping: TO_CHAR(ts, 'YYYY-MM-DD') gives a readable '2026-06-09' string - use this for any column shown to the user and for GROUP BY daily buckets. {fn SUBSTRING(ts, 1, 10)} also yields the leading YYYY-MM-DD substring.\nTrap: CAST(ts AS DATE) returns the IRIS internal day-count integer (e.g. 67705), NOT a readable date - useful for date arithmetic, useless for display. Do not show it to users."},
{"slug":"decode-functions","topic":"dialect","title":"Encoded columns: %EXTERNAL vs %ODBCOUT vs $LISTGET vs SUBSTRING","keywords":"decode,encoded,%external,%odbcout,enum,status,garbled,binary,display value,internal format","body":"IRIS persists several types in internal formats that look like garbage in raw output. Decode them:\nInteger-coded enum (status, type, business-type) -> %EXTERNAL(col) renders the display value (e.g. 1 -> 'BusinessService'). %ODBCOUT does NOT decode enums - it returns the raw integer.\n%Status value (error status) -> %ODBCOUT(col) renders the human-readable status/error string; raw output is binary garble.\n$LIST -> $LISTGET(col, N) extracts the Nth element (1-based).\nStream (longvarchar/longvarbinary) -> SUBSTRING(col, 1, N) reads the first N chars as a string.\nRule of thumb: integer enums -> %EXTERNAL; %Status -> %ODBCOUT. They are NOT interchangeable - using the wrong one returns either raw integers or garble."},
{"slug":"integer-string-trap","topic":"dialect","title":"Integer columns vs string literals: the silent no-op trap","keywords":"integer,string,literal,coercion,silent,no-op,zero rows,type,status,filter,trap,wrong results,matches nothing","body":"Several framework columns are integers even though they represent words ('Request', 'Completed'). Comparing them to a string literal does NOT error - IRIS coerces the non-numeric string to 0, which usually makes the predicate a silent no-op.\nWRONG: WHERE Type = 'Response' (Type is integer; 'Response' coerces to 0, matches NOTHING).\nWRONG: WHERE Status != 'Delivered' (becomes Status != 0, keeps ALL rows).\nRIGHT: WHERE Type = 2 (2 = Response), or WHERE %EXTERNAL(Status) != 'Delivered' (compare against the decoded text).\nThis is the #1 cause of 'my filter returns zero rows' and 'my exclusion is not excluding anything'. Whenever a filter behaves bizarrely, check whether the column is really an integer. On Ens.MessageHeader: Type (1=Request, 2=Response), Status, SourceBusinessType, and TargetBusinessType are all integers."},
{"slug":"case-and-exact","topic":"dialect","title":"Case sensitivity and %EXACT()","keywords":"case,case-insensitive,case-sensitive,%exact,collation,upper,group by,oid,url,exact","body":"IRIS SQL string comparisons, WHERE matching, GROUP BY, and LIKE are case-insensitive by default: WHERE Name = 'abc' matches 'ABC'. MessageBodyClassName is frequently stored ALL CAPS (HS.MESSAGE.PATIENTSEARCHREQUEST) - equality still matches, but be aware when you display or group the value.\nTo force case-sensitive behavior - essential when grouping/aggregating URLs, OIDs, identifiers, or joining to a catalog with EXACT collation - wrap the column in %EXACT(col):\nSELECT %EXACT(ai.AdditionalInfo) AS TargetURL, COUNT(*) AS Cnt FROM MyApp_Message.SomeBody_AdditionalInfo ai GROUP BY %EXACT(ai.AdditionalInfo)\nJoining %Dictionary.CompiledClass.Name (EXACT collation, mixed case) to an ALL-CAPS MessageBodyClassName requires UPPER() on BOTH sides - a plain = join returns nothing."},
{"slug":"list-extraction","topic":"dialect","title":"$LIST columns: $LISTGET extraction","keywords":"$list,$listget,$listlength,$listfromstring,list,nested,key value,serialized,control characters,position scan","body":"$LIST is the IRIS native binary list format; such columns show control-character headers in raw output. Extract with:\n$LISTGET(col, N) - Nth element (1-based). $LISTLENGTH(col) - element count.\nNested $LISTGET($LISTGET(col, N), M) for a $LIST of $LIST(key,value) pairs (common for serialized key-value properties): N selects the pair, M=1 is the key, M=2 is the value.\n$LISTFROMSTRING(str, delim) converts a DELIMITED STRING to a $LIST - do not use it on data that is already native $LIST format.\nHow to tell which you have: native $LIST shows binary control characters in raw SELECT; delimited strings show visible separators (commas/pipes).\nWhen a serialized list carries a variable key set (e.g. HTTP headers), a key's position is NOT stable across rows - scan a range of positions with a CASE that checks the key at each position. Position scans across many rows are CPU-heavy; bound the time window aggressively."},
{"slug":"stream-reading","topic":"dialect","title":"Stream columns: SUBSTRING, never SUBSTR","keywords":"stream,longvarchar,longvarbinary,substring,substr,charindex,locate,contentstream,xml,count occurrences","body":"To read a stream column (longvarchar/longvarbinary) as a string: SUBSTRING(stream_col, 1, N) - works on both types and outperforms CONVERT(VARCHAR(N), col), which can time out on unfiltered queries.\nSUBSTR does NOT work on streams (SQLCODE -37); only SUBSTRING works. The ODBC escape (fn LOCATE) does not work either (SQLCODE -40); use CHARINDEX('needle', SUBSTRING(stream_col, 1, N)), then SUBSTRING around the hit position to pull context.\nCounting occurrences of a marker in a stream (e.g. XML elements) - the length-difference trick:\n(CHAR_LENGTH(SUBSTRING(s, 1, 100000)) - CHAR_LENGTH(REPLACE(SUBSTRING(s, 1, 100000), '</TheTag>', ''))) / 9  -- 9 = length of '</TheTag>'"},
{"slug":"groupby-restrictions","topic":"dialect","title":"GROUP BY / ORDER BY restrictions: no computed aliases (SQLCODE -29)","keywords":"group by,order by,alias,sqlcode -29,subquery,computed expression,bucket,restriction","body":"You cannot reference a SELECT column alias in GROUP BY (and generally not in ORDER BY for computed expressions) - SQLCODE -29. Either repeat the full expression in GROUP BY, or (cleaner) compute the expression in an inner subquery and GROUP BY / ORDER BY the alias in the outer query:\nSELECT t.Bucket, COUNT(*) AS Cnt FROM (SELECT TO_CHAR(TimeCreated,'YYYY-MM-DD') AS Bucket FROM Ens.MessageHeader WHERE TimeCreated > DATEADD('day', -30, CURRENT_TIMESTAMP)) t GROUP BY t.Bucket ORDER BY t.Bucket DESC\nGROUP BY <the full TO_CHAR expression> directly also works; ORDER BY <alias> works for non-computed aliases. The subquery form sidesteps all the edge cases at once."},
{"slug":"reserved-aliases","topic":"dialect","title":"Reserved-word aliases: COUNT and ROWS are forbidden (SQLCODE -1)","keywords":"reserved word,alias,count,rows,sqlcode -1,column alias,rename","body":"COUNT and ROWS (among others) are reserved words and cannot be used as column aliases - SQLCODE -1. Use Total, Cnt, MsgCount, etc.\nSELECT COUNT(*) AS Total  -- good\nSELECT COUNT(*) AS Count  -- SQLCODE -1"},
{"slug":"count-distinct-cost","topic":"dialect","title":"COUNT(DISTINCT) is expensive; COUNT(*) vs COUNT(1) is a myth","keywords":"count distinct,expensive,aggregate,session count,count(*),count(1),temp file,cardinality,proxy","body":"COUNT(DISTINCT col) builds a distinct-value temp file that grows with cardinality - the most expensive aggregate on large tables. Where the data model allows, count a proxy instead: e.g. count session-start rows, SUM(CASE WHEN SessionId = ID THEN 1 ELSE 0 END), rather than COUNT(DISTINCT SessionId) - each session has exactly one ID = SessionId row, and the two are equal whenever sessions do not span the bucket boundary (e.g. midnight for daily buckets).\nCOUNT(*) vs COUNT(1): identical plan and cost in IRIS - COUNT(1) is parameterized to COUNT(?) and evaluated the same way. There is no performance advantage to either; use whichever reads clearly."},
{"slug":"prefix-match","topic":"dialect","title":"%STARTSWITH for efficient prefix matching","keywords":"%startswith,prefix,like,starts with,system schemas","body":"%STARTSWITH is an efficient prefix predicate:\nWHERE SCHEMA_NAME %STARTSWITH '%'  -- e.g. to find/exclude system schemas (negate with NOT)\nWHERE TargetConfigName %STARTSWITH 'MyApp.'\nPrefer it over LIKE 'prefix%' for prefix matching."},
{"slug":"hint-placement","topic":"dialect","title":"Optimizer hint placement: before the table name (except %NOLOCK)","keywords":"hint,%parallel,%ignoreindex,%nolock,placement,before table,sqlcode -25,optimizer,%allindex,%firsttable","body":"Index/parallel hints - %PARALLEL, %ALLINDEX, %IGNOREINDEX {idx}, %FIRSTTABLE, %INORDER, %STARTTABLE, %FULL - go BEFORE the table name: FROM %PARALLEL Ens.MessageHeader; FROM %IGNOREINDEX TimeCreated Ens.MessageHeader. Placing them after the table -> SQLCODE -25.\nException: %NOLOCK (read-uncommitted) goes AFTER the table name: FROM Ens.MessageHeader %NOLOCK. Some execution paths reject %NOLOCK (observed SQLCODE -25 via the Atelier query endpoint) - drop it there if it errors."}
]
}

/// <p>Topic: message-model (8 articles). JSON array of
/// <code>{slug, topic, title, keywords, body}</code>.</p>
XData MessageModel [ MimeType = application/json ]
{
[
{"slug":"persistence-projection","topic":"message-model","title":"How a %Persistent class becomes a SQL table","keywords":"persistent,projection,class,table,serial,embedded,flattened,collection,child table,relationship,rowid,idkey,transient","body":"In IRIS the class is the source of truth; the SQL table is a generated projection. Package -> schema, class short name -> table (dots to underscores except the last; see the class-to-table article). Projection rules:\nStored literal properties -> columns of the same name (overridable per-property with SqlFieldName); inherited properties are included in the subclass's table.\nRowID / %ID: every persistent class has an auto-assigned identity projected as the RowID column, named ID unless the class defines its own ID property (then ID1, ID2, ...). Always use %ID in joins. An IDKEY index makes the RowID a composite of chosen properties (common for child/relationship classes).\nEmbedded serial objects (%SerialObject) -> underscore-flattened columns in the SAME row: SAMLData_OrganizationID, Errors_HighestError, BirthPlace_City. You cannot join to these - they are plain columns on the parent row; deeper nesting just adds more underscores.\nCollection properties (list of / array of) -> a separate child table (commonly ParentTable_PropertyName) with an FK back to the parent RowID plus the element value and an element index/key. This is the mechanism behind _AdditionalInfo tables.\nRelationships -> child tables + foreign keys; a parent/child (dependent) relationship makes the child RowID incorporate the parent ID.\nCaution: calculated/transient properties are not stored, and a serialized $LIST held in a single column is NOT a relational collection - it cannot be joined and must be unpacked with $LISTGET."},
{"slug":"inheritance-extents-classname","topic":"message-model","title":"Inheritance, extents, polymorphism, and %CLASSNAME","keywords":"inheritance,extent,polymorphic,subclass,%classname,over-count,shared extent,id collision,base class,real class","body":"An extent is all stored rows for a persistent class. With the default storage projection a subclass B Extends A is part of A's extent: SELECT ... FROM A returns rows for A AND all its subclasses (polymorphic).\n%CLASSNAME reveals a row's real class - the authoritative per-row class identifier IRIS stores with every object: SELECT %ID, %CLASSNAME FROM A, or WHERE %CLASSNAME = 'My.App.B'.\nRowIDs are unique PER EXTENT, not globally: two unrelated persistent classes have independent ID counters, so the same integer ID exists in both.\nTwo distinct traps for message bodies:\n1. Across different body classes, IDs collide - MessageBodyId (the integer) is class-scoped, not globally unique. Always join headers to bodies on id AND class together, never on MessageBodyId alone.\n2. Within one base class's subclass hierarchy, base-table queries over-count - filtering only on the base class name (e.g. in an orphan NOT EXISTS) sweeps in live subclass messages that are headed under their OWN class names. Match the base class AND all subclasses with IN (...), enumerated from %Dictionary.CompiledClass (WHERE UPPER(Super) [ UPPER('Base.Class') - the [ operator means contains), or confirm each row with %CLASSNAME."},
{"slug":"header-spine","topic":"message-model","title":"Ens.MessageHeader: the routing spine","keywords":"ens.messageheader,header,spine,routing,sessionid,sourceconfigname,targetconfigname,timecreated,messagebody,metadata","body":"Every message that flows through an Interoperability production gets exactly one row in Ens.MessageHeader - the routing spine. It holds routing metadata (who sent it, who received it, when, status, error), NOT the payload.\nKey columns: ID/%ID (RowID); SessionId (groups one logical exchange; the FIRST message in a session has ID = SessionId); Type (integer: 1=Request, 2=Response); SourceConfigName / TargetConfigName (the production components a message went from/to - your primary routing filters); TimeCreated / TimeProcessed; Status (integer enum - decode with %EXTERNAL); IsError (bit); ErrorStatus (%Status - render with %ODBCOUT); CorrespondingMessageId (the correlated request/response partner - often 0/unpopulated on internal legs); MessageBodyClassName + MessageBodyId (the pointer to the payload table).\nMost trace questions start FROM Ens.MessageHeader with a time filter. Trace tables are huge - ALWAYS bound by time unless the user truly wants everything."},
{"slug":"header-body-join","topic":"message-model","title":"Header -> body join: id AND class together","keywords":"join,body,messagebodyid,messagebodyclassname,payload,header body,class-scoped,left join,body table","body":"The actual message content lives in a different table per message type, identified by two header columns: MessageBodyClassName (the full class name of the body) and MessageBodyId (the FK into that body table's %ID).\nINNER JOIN HS_Message.PatientSearchRequest body ON hdr.MessageBodyId = body.%ID WHERE hdr.MessageBodyClassName = 'HS.Message.PatientSearchRequest'\nCritical rules:\n1. Convert the class name to schema.table (dots to underscores except the last); confirm via %Dictionary.CompiledClass when unsure.\n2. ALWAYS include the MessageBodyClassName filter (or put it in the JOIN ON when mixing types). Without it the join is ambiguous and wrong, because:\n3. MessageBodyId is class-scoped, not globally unique - different body classes are separate extents with independent ID counters, so the same integer id exists in many body tables. Match id AND class together; never join on MessageBodyId alone.\n4. Use LEFT JOIN when not every header has a matching body of the filtered class; add MessageBodyId IS NOT NULL to skip no-body header rows defensively.\nBase/subclass over-counting: a base body table also returns its subclasses' rows - match the base class and all its subclasses with IN (...), or confirm each row's real class with %CLASSNAME."},
{"slug":"session-model","topic":"message-model","title":"Sessions: SessionId groups one exchange; first header has ID = SessionId","keywords":"session,sessionid,trace,initiating,session start,session finish,fan-out,dedupe,leg,exchange","body":"A SessionId ties together every header in one logical exchange (the inbound request, all internal routing legs it spawns, downstream calls, and the final response).\nSession-initiating header: ID = SessionId - exactly one per session. Join to it: INNER JOIN Ens.MessageHeader fsh ON fsh.ID = hdr.SessionId AND fsh.SessionId = hdr.SessionId (fsh.TimeCreated = session start time).\nFull session trace: SELECT ID, Type, SourceConfigName, TargetConfigName, MessageBodyClassName, TimeCreated, %EXTERNAL(Status) AS Status FROM Ens.MessageHeader WHERE SessionId = :session_id ORDER BY TimeCreated ASC\nSession finish (final response back to the initiator): LEFT JOIN Ens.MessageHeader lsh ON lsh.SessionId = fsh.SessionId AND lsh.TargetConfigName = fsh.SourceConfigName AND lsh.Type = 2 (lsh.TimeProcessed = session finish time).\nOne session usually contains many headers for the same body type (an inbound leg, a routed leg, fan-out legs). When you need exactly one, discriminate by TargetConfigName (or SourceConfigName) - pick the routing leg you mean - rather than MIN/MAX(ID) games."},
{"slug":"request-response-correlation","topic":"message-model","title":"Request/response correlation: three patterns","keywords":"request,response,correlation,correspondingmessageid,self-join,latency,pairing,swapped configs,single header","body":"Three ways to pair a request with its response - choose based on whether CorrespondingMessageId is populated for the flow:\nA. CorrespondingMessageId (when populated): LEFT JOIN Ens.MessageHeader resp ON resp.CorrespondingMessageId = hdr.%ID. It is bidirectional but NOT always populated - many internal/synchronous legs leave it 0/empty; verify on a sample before relying on it. Performance: on high-volume flows this join times out even with a WHERE time filter - add a matching time predicate ON THE JOIN itself (AND resp.TimeCreated > DATEADD('hour', -1, CURRENT_TIMESTAMP)) and keep the JOIN window in sync with the WHERE window.\nB. Self-join on SessionId + swapped configs (when CorrespondingMessageId is 0): LEFT JOIN Ens.MessageHeader rsh ON rsh.SessionId = rqh.SessionId AND rsh.TargetConfigName = rqh.SourceConfigName AND rsh.SourceConfigName = rqh.TargetConfigName AND rsh.Type = 2. Latency = DATEDIFF('ms', rqh.TimeCreated, rsh.TimeCreated).\nC. Single-header latency (no join at all): the request leg's own TimeProcessed - TimeCreated IS the response latency (TimeProcessed on the request header approximately equals the response header's TimeCreated): DATEDIFF('ms', rqh.TimeCreated, rqh.TimeProcessed). Prefer this when the operation is called many times per session (pairing would be ambiguous) and CorrespondingMessageId is 0 on those legs."},
{"slug":"errors-on-response","topic":"message-model","title":"IsError / ErrorStatus live on the response header","keywords":"iserror,errorstatus,error,response,failed,request failure,%odbcout,type=2,wrong leg","body":"IsError and ErrorStatus are set on the RESPONSE header (Type=2), not the request. Filtering IsError=1 on requests finds nothing. To judge whether a request failed, correlate to its response (via CorrespondingMessageId or the SessionId self-join - see request-response-correlation) and check resp.IsError / resp.ErrorStatus there.\nErrorStatus is a %Status - render with %ODBCOUT(ErrorStatus); raw output is binary garble.\nStatus (integer enum; decode with %EXTERNAL - observed 8 -> 'Error', 9 -> 'Completed') is independent of IsError.\nFor component-level error events that are not tied to a specific message leg, query Ens_Util.Log with Type = 2 (Error) instead."},
{"slug":"additionalinfo-pivot","topic":"message-model","title":"AdditionalInfo collection tables: key-value pivot","keywords":"additionalinfo,collection,key value,pivot,element_key,child table,left join,top 1,duplicate keys,metadata","body":"Many body classes have array/list properties that IRIS projects as a child collection table named {Table}_AdditionalInfo - the structured way to read per-message key-value metadata (endpoints, purposes, identifiers, headers). Typical columns: {ParentTable} (FK back to the parent body row's id - the column is NAMED AFTER the parent table), element_key (the key name - a case-sensitive string), AdditionalInfo (the value - note it is AdditionalInfo, NOT element_value).\nDiscover the available keys the first time you meet a body table:\nSELECT DISTINCT element_key, COUNT(*) AS Cnt FROM MyApp_Message.SomeBody_AdditionalInfo GROUP BY element_key ORDER BY Cnt DESC\nPivot keys into columns with one LEFT JOIN per key (always LEFT - not every row has every key):\nLEFT JOIN MyApp_Message.SomeBody_AdditionalInfo a1 ON b.ID = a1.SomeBody AND a1.element_key = 'TargetEndpoint'\nDuplicate keys per parent row are possible (multiple routing steps each add the same key). If a single value is expected, use a TOP 1 correlated subquery instead of a join to avoid row multiplication in aggregates:\n(SELECT TOP 1 x.AdditionalInfo FROM MyApp_Message.SomeBody_AdditionalInfo x WHERE x.SomeBody = b.ID AND x.element_key = 'TargetEndpoint') AS TargetEndpoint\nUse %EXACT() on the value when grouping case-significant data (URLs, OIDs). Verify the FK column and owning class via INFORMATION_SCHEMA - a same-named collection table can belong to a DIFFERENT persistent class and not FK to the table you expect."}
]
}

/// <p>Topic: performance (6 articles). JSON array of
/// <code>{slug, topic, title, keywords, body}</code>.</p>
XData Performance [ MimeType = application/json ]
{
[
{"slug":"cost-vs-runtime","topic":"performance","title":"The cost-vs-runtime trap: trust the clock, not EXPLAIN cost","keywords":"explain,cost,plan,runtime,estimate,optimizer,measure,cold,warm,cache,showplan,selectivity,read a plan,access path","body":"EXPLAIN SELECT ... returns the showplan as one row with a single Plan column containing an XML <plans> document (EXPLAIN runs through the same read-only SQL path as SELECT; only EXPLAIN SELECT is accepted - EXPLAIN of a write statement is rejected). Reading the plan: the SQL is echoed first; the Cost value is the optimizer's ESTIMATED relative cost derived from table statistics - NOT a runtime measurement; the module structure below it shows the access path - 'Read extent bitmap' / 'Read index map <IndexName>' names what drives the scan, 'Read master map' means per-row master reads (the cost floor), and materializing 'into a temp file' before TOP N means no short-circuit. Use cost only for relative comparison of two plans on the same instance against the same data; the magnitude does not transfer between instances.\nEstimated cost frequently disagrees with measured runtime - trust the clock. Verified failure modes:\n1. Parameterized literals fool selectivity estimates: forcing the optimizer off the time index onto an ID-ordered bitmap (%IGNOREINDEX TimeCreated) measured ~25x faster (25 s -> 1 s) DESPITE a 33x HIGHER estimated cost.\n2. Always-true range predicates (AND ID > 1, or SessionId >= :watermark) collapse estimated cost dramatically (observed ~500x) with NO change to the access path - an estimation artifact, not a speedup. Do not ship ID > 1 expecting speed; it is fragile and can backfire after statistics are re-gathered.\n3. Cold vs warm cache swamps plan differences: the same query measured ~142 s cold vs ~7-8 s warm (a 20x swing from caching alone) while EXPLAIN rated the cold-slower plan cheaper. Compare plans warm AND cold and trust measured time.\nEXPLAIN STAT is unreliable via the Atelier endpoint (returns near-zero runtime stats). Takeaway: use EXPLAIN cost to generate hypotheses about plan shape, then MEASURE to decide."},
{"slug":"parallel-hint","topic":"performance","title":"%PARALLEL: when it helps and when it hurts","keywords":"%parallel,parallel,hint,aggregate,anti-join,not exists,cores,oversubscribe,scan,subrange","body":"%PARALLEL splits the scan into ID subranges processed in parallel, merged by a coordinator. It goes BEFORE the table name: FROM %PARALLEL Ens.MessageHeader.\nHelps: large GROUP BY / COUNT / SUM scans, especially when the dominant cost is a per-row master-map read; large anti-joins (NOT EXISTS over big body tables) that otherwise time out serially - e.g. orphan detection, where there is no index on Ens.MessageHeader.MessageBodyId.\nHurts / no-ops: small tables - the optimizer may decline it (it is a request, not a guarantee); inside a scalar COUNT(*) subquery - counter-productive (observed slower than plain); many %PARALLEL queries at once - they oversubscribe cores and ALL time out. Run one at a time, and prefer off-peak on busy production systems (parallel workers compete with live traffic for CPU)."},
{"slug":"ignoreindex-pattern","topic":"performance","title":"%IGNOREINDEX: forcing a better access path","keywords":"%ignoreindex,force,access path,watermark,bitmap,order by id,short-circuit,top n,temp file,sort","body":"%IGNOREINDEX {idx} forbids the optimizer from using index {idx}, forcing a different access path. Placement: FROM %IGNOREINDEX TimeCreated Ens.MessageHeader (index name BEFORE the table name; after the table -> SQLCODE -25).\nVerified use case: SELECT TOP N ... WHERE MessageBodyClassName = 'X' AND ID > :watermark AND TimeCreated < :cutoff ORDER BY ID defaults to driving off the TimeCreated index, master-map-reading every candidate to apply the class filter, then materializing the WHOLE qualifying set into a temp file sorted by ID before taking TOP N (no short-circuit) - roughly O(N^2) across a watermark loop. Forcing %IGNOREINDEX TimeCreated makes it drive the ID-ordered MessageBodyClassName bitmap instead, which satisfies ORDER BY ID with no sort, touches only the target class, and short-circuits at TOP N. Measured ~25x faster despite a higher estimated cost.\nCaveat: it still master-reads each target-class row in ID order to test the TimeCreated cutoff, so an aggressive cutoff means reading more than N rows to fill a batch."},
{"slug":"indexing-realities","topic":"performance","title":"Indexing realities on Ens.MessageHeader","keywords":"index,bitmap,compound,master map,index-only,cost floor,information_schema.indexes,intersection,type filter","body":"Verified on a real instance (yours may differ - check INFORMATION_SCHEMA.INDEXES): Ens.MessageHeader indexes are typically single-column; commonly there are NO compound indexes. Bitmap indexes on TargetConfigName, MessageBodyClassName, TimeCreated, SourceConfigName, Status - a three-way bitmap intersection (e.g. TargetConfigName x MessageBodyClassName x TimeCreated) is fast. There is NO bitmap index on Type: a Type=1/2 filter is applied as a post-bitmap row-by-row test - it reduces results, not rows read; do not expect Type filtering to cut I/O. Standard (non-bitmap) indexes are physically keyed (value, ID).\nThe master-map read floor: any predicate needing a column NOT carried in the driving index forces a per-row master-map read. Example: a by-day SESSION count drives the TimeCreated index but must master-read each row for SessionId (not co-indexed) - that per-row read is the cost floor. By contrast a pure COUNT(*) grouped by TO_CHAR(TimeCreated,'YYYY-MM-DD') over a time range is index-only and returns in seconds even over multi-million-row tables; %PARALLEL splits the index range across cores.\nStorage globals: data ^Ens.MessageHeaderD, index ^Ens.MessageHeaderI."},
{"slug":"io-bound-vs-plan-bound","topic":"performance","title":"I/O-bound vs plan-bound (and the read-only projection-index pattern)","keywords":"i/o bound,plan bound,slow,tune table,projection index,covering index,system class,buildindices,reporting table,fat rows","body":"If a query is slow because it reads many fat body rows (large streams / SAML payloads), no amount of join rewriting helps - it is I/O-bound, not plan-bound. Signs: rewriting the join (pinning configs to literals, derived tables) yields the SAME plan and ~unchanged estimated cost. Levers that actually help: chunk by time, refresh statistics (TUNE TABLE), increase buffer-pool/global cache, run warm, or materialize a slim reporting table. Do not keep rewriting the query.\nThe read-only projection-index pattern: when a compound/covering index would make a query index-only but the table is a system class you must not modify (Ens.*, EnsLib.*, HS.* - overwritten on upgrade), create a separate persistent class whose storage points at the SAME data global but its OWN index global - define only the properties needed for the index + query (mapped to the original storage positions exactly) and the compound index. Inserts go through the original class, so the projection index does NOT auto-update - run %BuildIndices() on a scheduled task (acceptable for recent-/time-bounded data). Then query the projection table instead of the original.\nWhen to reach for it: the showplan shows bitmap intersection or per-row master reads as the dominant cost and a covering index would eliminate it, but the table is a system class."},
{"slug":"orphan-detection-caveats","topic":"performance","title":"Orphaned message-body detection: perf + correctness caveats","keywords":"orphan,not exists,over-count,subclass,shared extent,anti-join,%parallel,cleanup,delete,false positive","body":"An orphan is a persistent body row with no Ens.MessageHeader referencing it (body saved but never headed/routed, or its header was purged while the body lingered). The screen is a minefield:\nPure-SQL orphan counts OVER-COUNT for any base class that has subclasses (shared extent) - a base-class-only NOT EXISTS flags live, headed subclass messages as false orphans (verified: a base-only filter reported 51 orphans where the true count was 0).\nAlways match id AND class (MessageBodyId is class-scoped). Best-effort SQL matches the base class AND all its subclasses with IN (...), queried once per hierarchy, and needs %PARALLEL (there is no index on MessageBodyId, so serial anti-joins time out).\nEven this is not fully reliable - the IN (...) list is only as complete as the subclasses you enumerate (%Dictionary.CompiledClass); a missed/uncompiled live subclass re-introduces over-counting. The only fully reliable check confirms each candidate by its row's ACTUAL class (open the object, check the class name), which cannot be done in pure SQL. Leaf classes (no subclasses) are counted correctly on their own name.\nNever drive a DELETE from a SQL orphan count. Treat the number as a rough screen only."}
]
}

/// <p>Topic: discovery (2 articles). JSON array of
/// <code>{slug, topic, title, keywords, body}</code>.</p>
XData Discovery [ MimeType = application/json ]
{
[
{"slug":"custom-table-discovery-workflow","topic":"discovery","title":"Discovering custom application tables end-to-end","keywords":"discovery,information_schema,schemata,tables,columns,indexes,custom,unknown table,%dictionary.compiledclass,subclasses,sample,explore","body":"Assume the deployment is full of custom tables no guide documents - proprietary message-body classes plus non-message tables (lookup/reference/directory, config, search, reporting). Treat any unknown table as a discovery task, not a guess:\n1. List non-system schemas: SELECT SCHEMA_NAME FROM INFORMATION_SCHEMA.SCHEMATA WHERE NOT SCHEMA_NAME %STARTSWITH '%' ORDER BY SCHEMA_NAME\n2. List tables per schema, or search by name fragment across all schemas: SELECT TABLE_SCHEMA, TABLE_NAME FROM INFORMATION_SCHEMA.TABLES WHERE UPPER(TABLE_NAME) [ UPPER('directory') (the [ operator means contains; filter views out with TABLE_TYPE = 'BASE TABLE').\n3. Get the authoritative class behind a table (gotchas live at the class level): SELECT Name, SqlSchemaName, SqlTableName, Super, ClassType FROM %Dictionary.CompiledClass WHERE SqlSchemaName = 'My_App_Directory' AND SqlTableName = 'Organization'\n4. Read its columns and indexes via INFORMATION_SCHEMA.COLUMNS / INFORMATION_SCHEMA.INDEXES - flag FK-looking columns, stream/$LIST/%Status/enum columns, and what is indexed.\n5. Sample rows: SELECT TOP 5 * - confirm real encodings and population before trusting any column.\n6. Find how it links to the trace data - confirm join keys by sampling both sides and matching values by hand; watch the case-collation trap (UPPER both sides if either uses EXACT collation) and value prefixes like urn:oid:.\n7. Persist what you learned: columns, encodings, decode functions, confirmed join keys, gotchas, and which namespace/instance you verified them in.\nBest first query in any new namespace - which body types are actually in use: SELECT DISTINCT MessageBodyClassName, COUNT(*) AS MsgCount FROM Ens.MessageHeader WHERE TimeCreated > DATEADD('day', -7, CURRENT_TIMESTAMP) GROUP BY MessageBodyClassName ORDER BY MsgCount DESC\nEnumerate subclasses of a base class: SELECT Name FROM %Dictionary.CompiledClass WHERE UPPER(Super) [ UPPER('HS.Message.SomeResponse')"},
{"slug":"search-table-tip","topic":"discovery","title":"Ens.SearchTableBase search tables: a cheaper join target","keywords":"search table,searchtablebase,indexed,cheap join,stream parsing,property index,message content","body":"Many productions index message content into auto-populated search tables (Ens.SearchTableBase subclasses) - one row per indexed property, keyed back to the message. If you find a SearchTable-named class in the schema list, it can be a far cheaper join target than parsing the body stream: discover its columns and the id it carries back to Ens.MessageHeader, then filter/join on the search table instead of SUBSTRING-ing streams."}
]
}

/// <p>Topic: reference (3 articles). JSON array of
/// <code>{slug, topic, title, keywords, body}</code>.</p>
XData Reference [ MimeType = application/json ]
{
[
{"slug":"ens-messageheader-card","topic":"reference","title":"Ens.MessageHeader column card","keywords":"ens.messageheader,reference,columns,card,routing,header,field reference","body":"Ens.MessageHeader column card (representative ~24 columns; confirm via INFORMATION_SCHEMA.COLUMNS):\nID bigint - RowID; prefer %ID in joins.\nSessionId integer - groups a logical exchange; the first message has ID = SessionId. Single-column index.\nType integer - 1=Request, 2=Response. Never compare to strings. No bitmap index (post-filter; does not cut I/O).\nSourceConfigName / TargetConfigName varchar - sending/receiving production components. Bitmap-indexed; primary routing filters.\nTimeCreated timestamp - when the header was created; bitmap + range index; the usual time filter.\nTimeProcessed timestamp - when processing finished; on a request leg approximately equals the response's TimeCreated (basis for single-header latency).\nStatus integer - decode with %EXTERNAL(Status); observed 8 -> 'Error', 9 -> 'Completed'. Independent of IsError.\nIsError bit - set on the RESPONSE (Type=2), not the request.\nErrorStatus - %Status format; render with %ODBCOUT(ErrorStatus).\nMessageBodyClassName varchar - full class name of the body; often stored ALL CAPS; bitmap-indexed.\nMessageBodyId varchar - FK to the body table's %ID; CLASS-SCOPED, never join on it alone. Single-column index.\nCorrespondingMessageId integer - correlated partner header; bidirectional but often 0/unpopulated on internal legs.\nSourceBusinessType / TargetBusinessType integer - %EXTERNAL decodes: 1 -> 'BusinessService', 2 -> 'BusinessProcess', 3 -> 'BusinessOperation'.\nAlso: BusinessProcessId, Priority, Invocation, Banked, Resent, SuperSession, Description (often empty), ReturnQueueName, TargetQueueName.\nGotcha: ID magnitude is per-instance (tens of thousands on one box, millions on another) - never port a hardcoded ID > N floor between environments; it can silently exclude every row."},
{"slug":"ens-util-log-card","topic":"reference","title":"Ens.Util.Log (Ens_Util.Log) column card - the event log","keywords":"ens.util.log,ens_util.log,event log,error log,configname,timelogged,stack,type,alert,warning,trace","body":"Ens.Util.Log (SQL: Ens_Util.Log) is the Interoperability event log - errors, warnings, info, traces, alerts emitted by production components. Great for what-went-wrong-and-where; joins cleanly to Ens.MessageHeader.\nColumns: ConfigName varchar(128) - component that logged the event (bitmap index). Job - the $Job of the logging process. MessageId integer - FK to Ens.MessageHeader.%ID; the message current WHEN the event was logged, not necessarily the cause. SessionId integer. SourceClass / SourceMethod - what logged it. Stack - a $LIST of stack frames (errors only); extract with $LISTGET(Stack, N). StatusValue - %Status; render with %ODBCOUT; defaults to 1 (OK). Text varchar(32000) - the event message. TimeLogged timestamp (UTC) - standard index, efficient for time ranges. TraceCat - trace category (Type=5 only). Type integer - bitmap index; decode with %EXTERNAL.\nType values: 1 Assert, 2 Error, 3 Warning, 4 Info, 5 Trace, 6 Alert (also triggers SNMP/WMI notification).\nJoin patterns: LEFT JOIN Ens.MessageHeader hdr ON log.MessageId = hdr.%ID; from a header to its log entries: LEFT JOIN Ens_Util.Log log ON hdr.%ID = log.MessageId. To attribute a logged error to a body type in the same session, join through Ens.MessageHeader ON SessionId AND filter SourceConfigName to the component that logged the error - otherwise multiple messages per session inflate counts.\nGotchas: filter on the integer Type, display with %EXTERNAL(Type). Wide time windows with a ConfigName filter can time out - start with 1 day. Group noisy error text by a truncated prefix: GROUP BY SUBSTRING(Text, 1, 20) and display MIN(SUBSTRING(Text, 1, 255))."},
{"slug":"hs-body-patterns","topic":"reference","title":"HS.* HealthShare body-table patterns (verify names live)","keywords":"healthshare,hs.message,patientsearchrequest,xmlmessage,xdsb,queryresponse,fhir,saml,verify live,patterns,ihe,xcpd,xca","body":"Standard HealthShare body-class PATTERNS. The class names below are typical but deployment-dependent - VERIFY LIVE against your deployment before use; routing topology and component names are entirely deployment-specific. The patterns generalize; the names do not.\nHS.Message.PatientSearchRequest (HS_Message.PatientSearchRequest) - patient demographics search (IHE XCPD / FHIR patient flows). ~19 SAMLData_* underscore-flattened columns (embedded serial object, not a join). SAMLData_OrganizationID may carry a urn:oid: prefix - strip with REPLACE before joining an OID directory. Source-org data location is FLOW-DEPENDENT: sometimes the SAMLData_* columns, sometimes the _AdditionalInfo keys SAMLOrganization / SAMLOrganizationOID - check both, prefer whichever is populated. On responding/inbound (host) namespaces the PSR SAMLData_* columns are typically EMPTY - get the source org from the inbound HS.Message.XMLMessage of the same session instead. When a session has several PSR rows (routing chain), the earliest PSR usually carries SAMLOrganizationOID in AdditionalInfo regardless of its target - pick it with a MIN(ID) subquery against Ens.MessageHeader (filtered to the SessionId and the PSR class) to avoid duplicates. Target identity: COALESCE the RecOrgOID AdditionalInfo key (TOP 1 correlated subquery) with the Facility column - Facility may be a friendly alias, not an OID. Its Type column is a VARCHAR, unlike Ens.MessageHeader.Type (integer) - do not carry the integer assumption across tables.\nHS.Message.XMLMessage - generic SOAP/XML body (XCA query/retrieve, raw inbound envelopes). ContentStream is a stream - SUBSTRING only. SAML data lives on the INBOUND leg (Type=1); response and fan-out legs typically have EMPTY SAML - join back through SessionId to the inbound XMLMessage (discriminate by TargetConfigName when a session has several). SAMLData_SAMLInfo is a nested $LIST of $LIST(key,value) pairs - nested $LISTGET, not $LISTFROMSTRING.\nHS.Message.IHE.XDSb.QueryResponse - XDS.b registry query response; ContentStream carries the RegistryObjectList XML; count documents by counting closing ExtrinsicObject tags with the length-difference trick. Multiple QueryResponse rows per session (one per responding gateway) - SUM per-message counts via a correlated subquery filtered to the dedupe leg.\nHS.FHIRServer.Interop.Request - FHIR flows. Request_RequestPath / Request_QueryString for filters (e.g. Request_QueryString LIKE 'patient=%'). Request_AdditionalInfo is a SERIALIZED nested $LIST (not a relational collection; similarly-named collection tables in other FHIR schemas do NOT FK to this class). Key positions vary by row - scan positions ~6-12 with a CASE checking the key at each position; keys are KIND:NAME style (HEADER:SOURCE_ORGANIZATION_OID, USER:UserID). A FHIR session commonly has TWO request headers sharing one body (inbound + routed leg) - filter to the routed leg by SourceConfigName to avoid duplicates."}
]
}

/// <p>Topic: cookbook (12 articles). JSON array of
/// <code>{slug, topic, title, keywords, body}</code>. Placeholders:
/// <code>{component}</code>, <code>{Body.Class.Name}</code>,
/// <code>{BodySchema.BodyTable}</code>, <code>{BodyTable}</code> (the
/// AdditionalInfo FK column, named after the parent table),
/// <code>{LookupSchema.LookupTable}</code>, <code>{Subclass1}</code> /
/// <code>{Subclass2}</code>, <code>:session_id</code>,
/// <code>:watermark</code>, <code>:cutoff</code>.</p>
XData Cookbook [ MimeType = application/json ]
{
[
{"slug":"daily-counts","topic":"cookbook","title":"Daily message + session counts (scalable, no COUNT DISTINCT)","keywords":"daily,per day,counts,volume,messages per day,sessions per day,trend,recipe","body":"Daily message + session counts, scalable (no COUNT(DISTINCT)):\nSELECT TOP 100 TO_CHAR(TimeCreated, 'YYYY-MM-DD') AS Day, COUNT(*) AS MessageCount, SUM(CASE WHEN SessionId = ID THEN 1 ELSE 0 END) AS SessionCount FROM %PARALLEL Ens.MessageHeader WHERE TimeCreated >= DATEADD('day', -60, CURRENT_TIMESTAMP) GROUP BY TO_CHAR(TimeCreated, 'YYYY-MM-DD') ORDER BY Day DESC\nSUM(CASE WHEN SessionId = ID THEN 1 ELSE 0 END) counts session starts (each session has exactly one ID = SessionId row) - equal to distinct sessions whenever sessions do not cross midnight, and it avoids the distinct temp file.\nPer-component variant: add AND TargetConfigName = '{component}' (and bucket by TimeProcessed if you mean completion day)."},
{"slug":"errors-recent","topic":"cookbook","title":"Errors in the last 24 hours","keywords":"errors,recent,last 24 hours,failed,iserror,errortext,recipe","body":"Errors in the last 24 hours:\nSELECT TOP 50 ID, SessionId, TimeCreated, SourceConfigName, TargetConfigName, %ODBCOUT(ErrorStatus) AS ErrorText FROM Ens.MessageHeader WHERE IsError = 1 AND TimeCreated > DATEADD('day', -1, CURRENT_TIMESTAMP) ORDER BY TimeCreated DESC\nRemember IsError is set on the RESPONSE leg (Type=2) - this lists failing responses. To attribute failures to the requests that caused them, correlate response back to request (see the request-response-correlation article). Widen the window with DATEADD('day', -N, ...)."},
{"slug":"error-rate-by-dimension","topic":"cookbook","title":"Failure rate by a dimension, with time bucket","keywords":"failure rate,error rate,percentage,by dimension,group,endpoint,failures,recipe","body":"Failure rate grouped by a dimension (here an AdditionalInfo endpoint URL; swap the dimension for any column):\nSELECT %EXACT(ai.AdditionalInfo) AS TargetURL, COUNT(*) AS Total, SUM(CASE WHEN resp.IsError = 1 THEN 1 ELSE 0 END) AS Failures, CAST(SUM(CASE WHEN resp.IsError = 1 THEN 1 ELSE 0 END) * 100.0 / COUNT(*) AS DECIMAL(5,2)) AS FailurePct FROM Ens.MessageHeader rqh INNER JOIN {BodySchema.BodyTable} psr ON rqh.MessageBodyId = psr.%ID LEFT JOIN {BodySchema.BodyTable}_AdditionalInfo ai ON psr.%ID = ai.{BodyTable} AND ai.element_key = 'WSA:To' LEFT JOIN Ens.MessageHeader resp ON resp.CorrespondingMessageId = rqh.%ID AND resp.TimeCreated > DATEADD('day', -1, CURRENT_TIMESTAMP) WHERE rqh.MessageBodyClassName = '{Body.Class.Name}' AND rqh.TimeCreated > DATEADD('day', -1, CURRENT_TIMESTAMP) GROUP BY %EXACT(ai.AdditionalInfo) ORDER BY Failures DESC\nNotes: IsError lives on the response - hence the resp join; keep the JOIN and WHERE time windows in sync; %EXACT preserves URL case in grouping; the AdditionalInfo FK column is named after the parent table."},
{"slug":"latency-single-header","topic":"cookbook","title":"Business Operation response latency (single-header, no self-join)","keywords":"latency,response time,slow,business operation,timeprocessed,single header,recipe","body":"Business Operation response latency - single-header, no self-join:\nSELECT TOP 100 ID, SessionId, TimeCreated, DATEDIFF('ms', TimeCreated, TimeProcessed) AS ResponseMs FROM %PARALLEL Ens.MessageHeader WHERE Type = 1 AND TargetConfigName = '{component}' AND TimeCreated > DATEADD('day', -7, CURRENT_TIMESTAMP) ORDER BY ResponseMs DESC\nThe request leg's own TimeProcessed - TimeCreated IS the response latency (TimeProcessed on the request header approximately equals the response header's TimeCreated). Use this when CorrespondingMessageId is 0 on these legs and the operation fires many times per session (id-pairing would be ambiguous)."},
{"slug":"latency-corresponding-id","topic":"cookbook","title":"Request -> response latency via CorrespondingMessageId","keywords":"latency,correspondingmessageid,request response,pairing,recipe","body":"Request -> response latency via CorrespondingMessageId (when populated):\nSELECT TOP 100 rq.ID AS RequestId, rs.ID AS ResponseId, rq.TimeCreated AS RequestTime, rs.TimeCreated AS ResponseTime, DATEDIFF('ms', rq.TimeCreated, rs.TimeCreated) AS LatencyMs, rs.IsError FROM Ens.MessageHeader rq LEFT JOIN Ens.MessageHeader rs ON rs.CorrespondingMessageId = rq.%ID AND rs.TimeCreated > DATEADD('hour', -1, CURRENT_TIMESTAMP) WHERE rq.Type = 1 AND rq.TimeCreated > DATEADD('hour', -1, CURRENT_TIMESTAMP) ORDER BY LatencyMs DESC\nVerify CorrespondingMessageId is populated for your flow first (often 0 on internal legs). Keep the JOIN time window in sync with the WHERE window - without the JOIN-side bound this times out on high-volume flows."},
{"slug":"latency-self-join","topic":"cookbook","title":"Request -> response latency via SessionId self-join (swapped configs)","keywords":"latency,self-join,sessionid,swapped configs,request response,recipe","body":"Request -> response latency when CorrespondingMessageId is unpopulated (SessionId self-join with swapped configs):\nSELECT TOP 100 rqh.SessionId, rqh.TimeCreated AS ReqTime, rsh.TimeCreated AS RespTime, DATEDIFF('ms', rqh.TimeCreated, rsh.TimeCreated) AS LatencyMs, rsh.IsError FROM Ens.MessageHeader rqh LEFT JOIN Ens.MessageHeader rsh ON rsh.SessionId = rqh.SessionId AND rsh.TargetConfigName = rqh.SourceConfigName AND rsh.SourceConfigName = rqh.TargetConfigName AND rsh.Type = 2 WHERE rqh.Type = 1 AND rqh.SourceConfigName = '{component}' AND rqh.TimeCreated > DATEADD('day', -1, CURRENT_TIMESTAMP) ORDER BY LatencyMs DESC\nUse on internal legs where CorrespondingMessageId is unpopulated and the session fires the same request/response pair many times (which makes id-pairing ambiguous)."},
{"slug":"session-trace","topic":"cookbook","title":"Full trace of one session (chronological)","keywords":"session trace,one session,timeline,legs,chronological,recipe","body":"Full trace of one session, chronological:\nSELECT ID, Type, SourceConfigName, TargetConfigName, MessageBodyClassName, TimeCreated, %EXTERNAL(Status) AS Status, IsError FROM Ens.MessageHeader WHERE SessionId = :session_id ORDER BY TimeCreated ASC, ID ASC\nShows every leg of the exchange: the inbound request, internal routing legs, downstream calls, and the final response. The row with ID = SessionId is the session initiator (session start time = its TimeCreated)."},
{"slug":"noisy-error-grouping","topic":"cookbook","title":"Grouping noisy error text","keywords":"error grouping,noisy,distinct errors,prefix,min,truncated,recipe","body":"When %ODBCOUT(ErrorStatus) yields many near-identical strings differing only in trailing IDs/UUIDs/timestamps, group by a truncated prefix and display a representative full error with MIN():\nSELECT MIN(SUBSTRING(%ODBCOUT(rsh.ErrorStatus), 1, 255)) AS ErrorText, COUNT(*) AS Total FROM Ens.MessageHeader rsh WHERE rsh.IsError = 1 AND rsh.TimeCreated > DATEADD('day', -1, CURRENT_TIMESTAMP) GROUP BY SUBSTRING(%ODBCOUT(rsh.ErrorStatus), 1, 20) ORDER BY Total DESC\nWiden/narrow the prefix length (20) to tune grouping granularity. The same pattern works on Ens_Util.Log.Text."},
{"slug":"aggregate-first-join","topic":"cookbook","title":"Aggregate first, then join lookups","keywords":"aggregate first,lookup,reference table,subquery,join cost,directory,recipe","body":"When aggregating header/body data and joining to a small lookup/reference/directory table, aggregate FIRST in a subquery, then join the lookup to the few distinct grouped keys - not to every one of millions of message rows:\nSELECT dir.Name, agg.MsgCount FROM (SELECT hdr.SomeKey, COUNT(*) AS MsgCount FROM Ens.MessageHeader hdr WHERE hdr.TimeCreated > DATEADD('day', -7, CURRENT_TIMESTAMP) GROUP BY hdr.SomeKey) agg LEFT JOIN {LookupSchema.LookupTable} dir ON agg.SomeKey = dir.SomeKey ORDER BY agg.MsgCount DESC\nAlso reduces bitmap-intersection cost - push non-essential filters out of the inner scan and let the join/subquery do the filtering."},
{"slug":"watermark-scan","topic":"cookbook","title":"Watermark / batch scan by body class (forced bitmap)","keywords":"watermark,batch,scan,pagination,%ignoreindex,incremental,recipe","body":"Watermark / batch scan by body class (forced bitmap; short-circuits at TOP N):\nSELECT TOP 1000 ID, MessageBodyId FROM %IGNOREINDEX TimeCreated Ens.MessageHeader WHERE MessageBodyClassName = '{Body.Class.Name}' AND ID > :watermark AND TimeCreated < :cutoff ORDER BY ID\nForcing the ID-ordered MessageBodyClassName bitmap (off the time index) makes ORDER BY ID sort-free and short-circuits at TOP N - roughly constant work per batch. Loop: feed the max ID returned back in as the next :watermark."},
{"slug":"doc-count","topic":"cookbook","title":"Document count from a response stream (tag counting)","keywords":"document count,stream,extrinsicobject,xdsb,tag count,char_length,replace,recipe","body":"Document count per message from a response stream - count closing tags via the length-difference trick (22 = length of '</rim:ExtrinsicObject>'; adapt tag + length for other markers):\nSELECT TOP 100 hdr.SessionId, hdr.TimeCreated, (CHAR_LENGTH(SUBSTRING(qr.ContentStream, 1, 100000)) - CHAR_LENGTH(REPLACE(SUBSTRING(qr.ContentStream, 1, 100000), '</rim:ExtrinsicObject>', ''))) / 22 AS Doc_Count FROM Ens.MessageHeader hdr INNER JOIN HS_Message_IHE_XDSb.QueryResponse qr ON hdr.MessageBodyId = qr.%ID WHERE hdr.MessageBodyClassName = 'HS.Message.IHE.XDSb.QueryResponse' AND hdr.TimeCreated > DATEADD('day', -1, CURRENT_TIMESTAMP) ORDER BY Doc_Count DESC\nFor a session total across multiple response rows, wrap the count in a correlated SUM subquery filtered to the dedupe leg (TargetConfigName). Streams: SUBSTRING only, never SUBSTR."},
{"slug":"orphan-screen","topic":"cookbook","title":"Orphaned-body screen (rough; read-only; never drives a delete)","keywords":"orphan,screen,not exists,cleanup,unreferenced,body rows,recipe","body":"Orphaned-body screen (rough; read-only; NEVER drives a delete):\nSELECT COUNT(*) FROM %PARALLEL {BodySchema.BodyTable} b WHERE NOT EXISTS (SELECT 1 FROM Ens.MessageHeader h WHERE h.MessageBodyId = b.%ID AND h.MessageBodyClassName IN ('{Body.Class.Name}', '{Subclass1}', '{Subclass2}'))\nMatch the base class AND all its subclasses (a shared extent over-counts otherwise; enumerate subclasses via %Dictionary.CompiledClass WHERE UPPER(Super) [ UPPER('{Body.Class.Name}')). %PARALLEL because there is no index on MessageBodyId - serial anti-joins time out. Treat the number as a rough screen only - authoritative orphan detection needs object-level class confirmation, which pure SQL cannot do."}
]
}

